DATABASE_URL=postgresql+asyncpg://pme:password@localhost:5432/pme
REDIS_URL=redis://localhost:6379/0

# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
# KEY_PEPPER: changing it invalidates every existing API key. Keep it out of the database and git.
KEY_PEPPER=
SESSION_SECRET=

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# Tests only (database name MUST end in _test):
TEST_DATABASE_URL=postgresql+asyncpg://pme:password@localhost:5432/pme_test
TEST_REDIS_URL=redis://localhost:6379/15
